PORT=3000
DATA_DIR=./data
ENCRYPTED_DIR=./data/encrypted
# Which rosters/<year>/final_rosters.json to load (see npm run build-rosters)
CURRENT_YEAR=2025
LOG_FILE=./data/keepers.log

# ESPN fantasy API (scripts/fetch-espn.js). Copy espn_s2 and SWID cookie
# values from a logged-in fantasy.espn.com session (DevTools > Application >
# Cookies). espn_s2 lasts about a year.
ESPN_LEAGUE_ID=577910
ESPN_S2=
ESPN_SWID=
